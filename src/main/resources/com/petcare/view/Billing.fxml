<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.petcare.controller.BillingController"
      spacing="16">

    <!-- Top Action Bar & Filters -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Filter Status:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="statusFilterCombo" prefWidth="140"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="➕ New Invoice" onAction="#handleCreateInvoice" styleClass="btn-primary"/>
        <Button text="💳 Collect Payment" onAction="#handleRecordPayment" styleClass="btn-success"/>
        <Button text="🧾 View / Print Receipt" onAction="#handleViewInvoice" styleClass="btn-secondary"/>
        <Button text="🔄 Refresh" onAction="#loadInvoices" styleClass="btn-secondary"/>
    </HBox>

    <!-- Invoices Table -->
    <TableView fx:id="invoiceTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colInvoiceNum" text="Invoice #" prefWidth="140"/>
            <TableColumn fx:id="colDate" text="Date Issued" prefWidth="120"/>
            <TableColumn fx:id="colPet" text="Patient Pet" prefWidth="150"/>
            <TableColumn fx:id="colOwner" text="Pet Owner" prefWidth="180"/>
            <TableColumn fx:id="colTotal" text="Total Amount" prefWidth="140"/>
            <TableColumn fx:id="colStatus" text="Payment Status" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
