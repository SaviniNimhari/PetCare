<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.petcare.controller.LoginController"
           styleClass="login-root" stylesheets="@../../../css/login.css">
    
    <VBox alignment="CENTER" maxWidth="440" maxHeight="580" spacing="20" styleClass="login-card">
        <VBox alignment="CENTER" spacing="6">
            <Label text="🐾 PetCare" styleClass="login-title"/>
            <Label text="Pet Clinic &amp; Veterinary Management System" styleClass="login-subtitle"/>
        </VBox>

        <Separator/>

        <VBox spacing="14">
            <VBox spacing="4">
                <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <TextField fx:id="usernameField" promptText="Enter your username" style="-fx-pref-height: 38px;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-pref-height: 38px;"/>
            </VBox>

            <VBox spacing="4" styleClass="demo-account-box">
                <Label text="⚡ Quick Role Demo Login:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0D9488;"/>
                <ComboBox fx:id="quickLoginCombo" promptText="Select Demo Account..." maxWidth="Infinity"/>
            </VBox>

            <Button text="Sign In to PetCare" onAction="#handleLogin" maxWidth="Infinity" styleClass="login-btn"/>
        </VBox>

        <Label fx:id="statusLabel" text="" style="-fx-text-fill: #DC2626; -fx-font-size: 12px;"/>

        <HBox alignment="CENTER" spacing="10">
            <Button text="Exit Application" onAction="#handleExit" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-underline: true; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

</StackPane>
