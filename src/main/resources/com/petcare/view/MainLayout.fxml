<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.petcare.controller.MainLayoutController"
            stylesheets="@../../../css/style.css"
            prefWidth="1280" prefHeight="800">
    
    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="20">
            <!-- Brand Logo & Name -->
            <VBox spacing="2">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🐾" style="-fx-font-size: 26px;"/>
                    <VBox>
                        <Label text="PetCare" styleClass="brand-title"/>
                        <Label text="VETERINARY CLINIC" styleClass="brand-subtitle"/>
                    </VBox>
                </HBox>
            </VBox>

            <Separator style="-fx-opacity: 0.15;"/>

            <!-- Navigation Buttons -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="6">
                    <Button fx:id="btnNavDashboard" text="📊   Dashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-button"/>
                    <Button fx:id="btnNavPets" text="🐶   Pets &amp; Owners" maxWidth="Infinity" onAction="#showPets" styleClass="nav-button"/>
                    <Button fx:id="btnNavAppointments" text="📅   Appointments" maxWidth="Infinity" onAction="#showAppointments" styleClass="nav-button"/>
                    <Button fx:id="btnNavVets" text="🩺   Veterinarians" maxWidth="Infinity" onAction="#showVeterinarians" styleClass="nav-button"/>
                    <Button fx:id="btnNavRecords" text="📋   Medical Records" maxWidth="Infinity" onAction="#showMedicalRecords" styleClass="nav-button"/>
                    <Button fx:id="btnNavInventory" text="💊   Pharmacy &amp; Stock" maxWidth="Infinity" onAction="#showInventory" styleClass="nav-button"/>
                    <Button fx:id="btnNavBilling" text="💳   Billing &amp; Invoices" maxWidth="Infinity" onAction="#showBilling" styleClass="nav-button"/>
                    <Button fx:id="btnNavReports" text="📈   Reports" maxWidth="Infinity" onAction="#showReports" styleClass="nav-button"/>
                </VBox>
            </ScrollPane>

            <Separator style="-fx-opacity: 0.15;"/>

            <!-- User Info & Logout Button -->
            <VBox spacing="10">
                <VBox spacing="3">
                    <Label fx:id="userFullNameLabel" text="User Full Name" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <Label fx:id="userRoleBadge" text="ADMIN" styleClass="role-pill"/>
                </VBox>
                <Button text="🚪   Sign Out" maxWidth="Infinity" onAction="#handleLogout" styleClass="btn-danger"/>
            </VBox>
        </VBox>
    </left>

    <!-- CENTER AREA -->
    <center>
        <BorderPane>
            <!-- TOP HEADER -->
            <top>
                <HBox alignment="CENTER_LEFT" styleClass="top-bar" spacing="16">
                    <Label fx:id="currentPageTitle" text="Dashboard Overview" styleClass="page-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="12">
                        <Label text="Clinic Status: 🟢 Open" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #15803D;"/>
                    </HBox>
                </HBox>
            </top>

            <!-- DYNAMIC MODULE VIEW CONTENT -->
            <center>
                <StackPane fx:id="contentArea" style="-fx-padding: 20px;"/>
            </center>
        </BorderPane>
    </center>

</BorderPane>
