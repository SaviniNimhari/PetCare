<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.petcare.controller.DashboardController"
            fitToWidth="true" style="-fx-background-color: transparent;">
    
    <VBox spacing="20">
        <!-- TOP KPI CARDS GRID -->
        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <!-- Card 1: Registered Pets -->
            <VBox GridPane.columnIndex="0" styleClass="kpi-card" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🐾" style="-fx-font-size: 20px;"/>
                    <Label text="TOTAL REGISTERED PETS" styleClass="kpi-title"/>
                </HBox>
                <Label fx:id="totalPetsLabel" text="0" styleClass="kpi-value"/>
                <Label text="Active clinic patients" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
            </VBox>

            <!-- Card 2: Veterinarians -->
            <VBox GridPane.columnIndex="1" styleClass="kpi-card" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🩺" style="-fx-font-size: 20px;"/>
                    <Label text="ACTIVE VETERINARIANS" styleClass="kpi-title"/>
                </HBox>
                <Label fx:id="totalVetsLabel" text="0" styleClass="kpi-value"/>
                <Label text="Doctors on duty" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
            </VBox>

            <!-- Card 3: Today's Appointments -->
            <VBox GridPane.columnIndex="2" styleClass="kpi-card" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📅" style="-fx-font-size: 20px;"/>
                    <Label text="TODAY'S APPOINTMENTS" styleClass="kpi-title"/>
                </HBox>
                <Label fx:id="todayAppointmentsLabel" text="0" styleClass="kpi-value"/>
                <Label fx:id="upcomingVaccinationsLabel" text="0 due soon" style="-fx-font-size: 11px; -fx-text-fill: #0D9488; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Card 4: Monthly Revenue -->
            <VBox GridPane.columnIndex="3" styleClass="kpi-card" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="💰" style="-fx-font-size: 20px;"/>
                    <Label text="MONTHLY REVENUE" styleClass="kpi-title"/>
                </HBox>
                <Label fx:id="monthlyRevenueLabel" text="$0.00" styleClass="kpi-value"/>
                <Label fx:id="lowStockLabel" text="0 low stock items" style="-fx-font-size: 11px; -fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
            </VBox>
        </GridPane>

        <!-- CHARTS SECTION -->
        <HBox spacing="16" prefHeight="300">
            <!-- Appointments Distribution -->
            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="10" prefWidth="480">
                <Label text="Appointment Status Overview" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E293B;"/>
                <PieChart fx:id="appointmentPieChart" legendVisible="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Revenue Trend -->
            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="10" prefWidth="540">
                <Label text="Clinic Revenue Trend ($)" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E293B;"/>
                <BarChart fx:id="revenueBarChart" legendVisible="false" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Month"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Amount ($)"/>
                    </yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- TODAY'S SCHEDULE -->
        <VBox styleClass="kpi-card" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Today's Scheduled Appointments" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #0F172A;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Refresh" onAction="#loadDashboardData" styleClass="btn-secondary"/>
            </HBox>

            <TableView fx:id="todayScheduleTable" prefHeight="220" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colTime" text="Time" prefWidth="90"/>
                    <TableColumn fx:id="colPet" text="Pet Name" prefWidth="140"/>
                    <TableColumn fx:id="colOwner" text="Owner" prefWidth="170"/>
                    <TableColumn fx:id="colVet" text="Veterinarian" prefWidth="180"/>
                    <TableColumn fx:id="colReason" text="Reason / Symptoms" prefWidth="250"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

</ScrollPane>
