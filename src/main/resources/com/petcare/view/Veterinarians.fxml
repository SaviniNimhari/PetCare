<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.petcare.controller.VeterinarianController"
      spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Clinic Veterinary Staff" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #0F172A;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Add Veterinarian" onAction="#handleAddVet" styleClass="btn-primary"/>
        <Button text="✏️ Edit Doctor" onAction="#handleEditVet" styleClass="btn-secondary"/>
        <Button text="🗑️ Remove" onAction="#handleDeleteVet" styleClass="btn-danger"/>
        <Button text="🔄 Refresh" onAction="#loadVeterinarians" styleClass="btn-secondary"/>
    </HBox>

    <TableView fx:id="vetTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colVetName" text="Doctor Name" prefWidth="170"/>
            <TableColumn fx:id="colSpecialization" text="Specialization" prefWidth="220"/>
            <TableColumn fx:id="colLicense" text="License #" prefWidth="130"/>
            <TableColumn fx:id="colFee" text="Consultation Fee" prefWidth="120"/>
            <TableColumn fx:id="colDays" text="Available Days" prefWidth="140"/>
            <TableColumn fx:id="colPhone" text="Phone" prefWidth="130"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
