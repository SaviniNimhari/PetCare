<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.petcare.controller.AppointmentController"
      spacing="16">

    <!-- Top Action Bar & Filters -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Filter by Status:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="statusFilterCombo" prefWidth="150"/>

        <Label text="Date:" style="-fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>
        <DatePicker fx:id="dateFilterPicker" prefWidth="150"/>
        
        <Button text="Reset" onAction="#handleResetFilters" styleClass="btn-secondary"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="➕ Book Appointment" onAction="#handleBookAppointment" styleClass="btn-primary"/>
        <Button text="✏️ Edit / Reschedule" onAction="#handleEditAppointment" styleClass="btn-secondary"/>
        <Button text="⏳ In Progress" onAction="#handleMarkInProgress" styleClass="btn-secondary"/>
        <Button text="✅ Completed" onAction="#handleMarkCompleted" styleClass="btn-success"/>
        <Button text="❌ Cancel" onAction="#handleCancelAppointment" styleClass="btn-danger"/>
    </HBox>

    <!-- Appointments Table -->
    <TableView fx:id="appointmentTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colId" text="#" prefWidth="40"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colTime" text="Time" prefWidth="85"/>
            <TableColumn fx:id="colPet" text="Pet" prefWidth="130"/>
            <TableColumn fx:id="colOwner" text="Owner" prefWidth="160"/>
            <TableColumn fx:id="colVet" text="Assigned Doctor" prefWidth="180"/>
            <TableColumn fx:id="colReason" text="Purpose / Symptoms" prefWidth="250"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
